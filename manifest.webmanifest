{
  "name": "Red Circle PDF Editor",
  "short_name": "PDF Editor",
  "description": "Edit, sign, fill, convert and organize PDFs. Files stay on your computer.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#d6362f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] }, "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }], "launch_type": "multiple-clients" }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
